#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

read -rp "Package name (e.g. 'hyprland' → n0ctos-hyprland): " PKG_NAME
PKG_NAME="${PKG_NAME// /-}"
DIR="n0ctos-${PKG_NAME}"
PKG_DIR="$SCRIPT_DIR/$DIR"

if [ -z "$PKG_NAME" ]; then
    echo "Error: package name cannot be empty"
    exit 1
fi

if [ -d "$PKG_DIR" ]; then
    echo "Error: directory '$DIR' already exists"
    exit 1
fi

mkdir -p "$PKG_DIR/config/default"
mkdir -p "$PKG_DIR/config/custom"

cat > "$PKG_DIR/PKGBUILD" << EOF
# Maintainer: N0ctane._.Dev <n0ctanedev@gmail.com>

pkgname=n0ctos-${PKG_NAME}
pkgver=1.0.0
pkgrel=1
pkgdesc="Config package for ${PKG_NAME} on N0ctOS"
arch=('x86_64' 'aarch64')
url="https://github.com/n0ctaneteam/N0ctOS-configs"
license=('GPL3')
depends=('${PKG_NAME}')
conflicts=('${PKG_NAME}')
provides=('${PKG_NAME}')
install=n0ctos-${PKG_NAME}.install

source=(
  'config/default/'
  'config/custom/'
)
sha256sums=('SKIP' 'SKIP')

package() {
  install -dm755 "\$pkgdir/usr/share/N0ctOS/config/\$pkgname"
  cp -r "\$srcdir/config/default/"* "\$pkgdir/usr/share/N0ctOS/config/\$pkgname/"

  install -dm755 "\$pkgdir/usr/share/N0ctOS/config/\$pkgname/custom"
  cp -r "\$srcdir/config/custom/"* "\$pkgdir/usr/share/N0ctOS/config/\$pkgname/custom/"
}
EOF

cat > "$PKG_DIR/n0ctos-${PKG_NAME}.install" << EOF
post_install() {
    local _user="\${SUDO_USER:-\$USER}"
    if [ -n "\$_user" ] && [ "\$_user" != "root" ]; then
        local _home
        _home=\$(getent passwd "\$_user" | cut -d: -f6)
        if [ -d "\$_home" ] && [ -d "/usr/share/N0ctOS/config/\$pkgname/custom" ]; then
            mkdir -p "\$_home/.config/\$pkgname"
            mv /usr/share/N0ctOS/config/\$pkgname/custom/* "\$_home/.config/\$pkgname/" 2>/dev/null || true
            rm -rf "/usr/share/N0ctOS/config/\$pkgname/custom"
        fi
    fi
}

post_remove() {
    rm -rf "/usr/share/N0ctOS/config/\$pkgname"
    local _user="\${SUDO_USER:-\$USER}"
    if [ -n "\$_user" ] && [ "\$_user" != "root" ]; then
        local _home
        _home=\$(getent passwd "\$_user" | cut -d: -f6)
        rm -rf "\$_home/.config/\$pkgname" 2>/dev/null || true
    fi
}
EOF

chmod +x "$PKG_DIR/PKGBUILD"

echo "Created package: $DIR"
echo "  ├── PKGBUILD"
echo "  ├── n0ctos-${PKG_NAME}.install"
echo "  └── config/"
echo "      ├── default/   <- system defaults → /usr/share/N0ctOS/config/${DIR}/"
echo "      └── custom/    <- user configs    → ~/.config/${PKG_NAME}/"
echo ""
echo "Fill config/default/ and config/custom/ with your files, then run:"
echo "  cd $DIR && makepkg -sCcf --sign"
