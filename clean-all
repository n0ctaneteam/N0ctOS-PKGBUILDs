#!/bin/bash

KEEP=(
    "PKGBUILD"
    ".SRCINFO"
    "*.install"
    "config"
    "config/*"
    "config/default/*"
    "config/custom/*"
    '*.desktop'
)

REPO_ROOT="$(cd "$(dirname "$0")" && pwd)"

should_keep() {
    local item="$1"
    local name="$(basename "$item")"

    for rule in "${KEEP[@]}"; do
        [[ "$name" == $rule ]] && return 0
        [[ "$item" == $rule ]] && return 0
        [[ "$item" == */$rule ]] && return 0
        [[ "$item" == */$rule/* ]] && return 0
    done

    return 1
}

echo "== N0ctOS Clean-All =="
echo "Root: $REPO_ROOT"
echo ""

for subdir in "$REPO_ROOT"/*/; do
    [ -d "$subdir" ] || continue
    [ "$(basename "$subdir")" == ".git" ] && continue

    echo ">> Cleaning: $(basename "$subdir")"

    cd "$subdir"

    for item in "$subdir"*; do
        [ -e "$item" ] || continue
        if should_keep "$item"; then
            echo "  [KEEP] $(basename "$item")"
        else
            echo "  [RM]   $(basename "$item")"
            rm -rf "$item"
        fi
    done

    echo ""
done

echo "== Done =="
