#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

DIFF_REPO=configs
TARGET_REPO=configs
DEPLOY_DIR="$SCRIPT_DIR/__deployed__/x86_64"
REPO_DIR="$SCRIPT_DIR"

cd "$DEPLOY_DIR"

rm -f N0ctOS-configs.*

repo-add --sign N0ctOS-configs.db.tar.zst *.pkg.tar.zst

mv -f N0ctOS-configs.db.tar.zst     N0ctOS-configs.db
mv -f N0ctOS-configs.db.tar.zst.sig N0ctOS-configs.db.sig
mv -f N0ctOS-configs.files.tar.zst     N0ctOS-configs.files
mv -f N0ctOS-configs.files.tar.zst.sig N0ctOS-configs.files.sig

cd "$REPO_DIR"

GIT_USER="$(git config user.name)"
CURRENT_TIME="$(date '+%Y-%m-%d/%H-%M-%S')"
BRANCH="$GIT_USER"/"$CURRENT_TIME"

git checkout -b "$BRANCH"
git add .
git commit -m "Update by $GIT_USER at $CURRENT_TIME"
git push --set-upstream origin "$BRANCH"

notify-send \
    -a 'N0ctOS PKG pusher' \
    -t 10000 \
    'N0ctOS PKG pusher:' \
    "Changes Pushed !!! Generating PR..."

CHANGED_PKGS=$(git diff origin/"$DIFF_REPO" --name-only \
    | grep '__deployed__/x86_64/.*\.pkg\.tar\.zst$' \
    | grep -v '\.sig$' \
    | xargs -I{} basename {} \
    | sed 's/-x86_64\.pkg\.tar\.zst$//' \
    | sort)

if [ -z "$CHANGED_PKGS" ]; then
    notify-send \
        -a 'N0ctOS PKG pusher' \
        -t 5000 \
        'N0ctOS PKG pusher:' \
        "No package changes detected, skipping PR"
    exit 0
fi

PKG_COUNT=$(( $(wc -l <<< "$CHANGED_PKGS") / 2 ))
PKG_LIST=$(echo "$CHANGED_PKGS" | sed 's/^/- /')

PR_BODY="## ⚙️ Package Update
**Pushed by:** \`$GIT_USER\`
**Time:** \`$CURRENT_TIME\`
**Packages changed:** $PKG_COUNT

### Changed Packages
$PKG_LIST

### Admin Checklist
- [ ] PKGBUILD looks clean
- [ ] Package versions make sense
- [ ] No suspicious files outside package directory
- [ ] DB is unsigned (do not approve if \`.db.sig\` exists)

> Add the \`APPROVED\` label to trigger signing and merge into \`testing\`"

PR_URL=$(gh pr create \
    --base $TARGET_REPO \
    --head "$BRANCH" \
    --title "⚙️ [$GIT_USER] $PKG_COUNT pkg(s) updated @ $CURRENT_TIME" \
    --body "$PR_BODY")

notify-send \
    -a 'N0ctOS PKG pusher' \
    -t 10000 \
    'N0ctOS PKG pusher:' \
    "PR Created: $PR_URL"
